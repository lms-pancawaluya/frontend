        <p><span className="font-medium text-[var(--color-navy)]">Nama:</span> {user.nama}</p>
        <p><span className="font-medium text-[var(--color-navy)]">Email:</span> {user.email}</p>
        <p><span className="font-medium text-[var(--color-navy)]">Role:</span> {user.role}</p>
      </div>
    </div>
  </div>
);
}
